#include <winuser.h>
#include <winver.h>
#include "ProductInfo.h"

1 ICON "stepmania.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "stepmania.manifest"

/* What Explorer's Details tab shows.  An exe that says what it is also looks
 * less like an anonymous download to antivirus heuristics. */
1 VERSIONINFO
FILEVERSION 3,9,0,0
PRODUCTVERSION 3,9,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "StepMania development team"
			VALUE "FileDescription", PRODUCT_NAME_VER
			VALUE "FileVersion", PRODUCT_VER
			VALUE "InternalName", "stepmania"
			VALUE "LegalCopyright", "(c) Chris Danford, the StepMania development team, et al."
			VALUE "OriginalFilename", "stepmania.exe"
			VALUE "ProductName", PRODUCT_NAME
			VALUE "ProductVersion", PRODUCT_VER
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
