stepmania_sources = [
  files('StepMania.cpp', 'global.cpp', 'SDL_utils.cpp'),
  screens,
  data_structures,
  file_types,
  actors,
  rage,
  rage_file,
  global_singletons,
  crypt_helpers,
  arch,
]

deps = [
  threads_dep,
  dl_dep,
  minacalc_dep,
  winmm_dep,
  ws2_dep,
  m_dep,
  gl_dep,
  glu_dep,
  zlib_dep,
  sqlite_dep,
  png_dep,
  iconv_dep,
  lua_dep,
  crypto_dep,
  pcre_dep,
  samplerate_dep,
  sdl_dep,
]

if alsa_dep.found()
  stepmania_sources += files(
    'arch/Sound/ALSA9Dynamic.cpp',
    'arch/Sound/ALSA9Helpers.cpp',
    'arch/Sound/RageSoundDriver_ALSA9.cpp',
    'arch/Sound/RageSoundDriver_ALSA9_Software.cpp',
  )
  deps += alsa_dep.partial_dependency(compile_args: true, includes: true)
endif

if have_oss
  stepmania_sources += files('arch/Sound/RageSoundDriver_OSS.cpp')
endif

if sndio_dep.found()
  stepmania_sources += files('arch/Sound/RageSoundDriver_Sndio.cpp')
  deps += sndio_dep
endif

if have_ffmpeg
  stepmania_sources += files('arch/MovieTexture/MovieTexture_FFMpeg.cpp')
  deps += ffmpeg_deps
endif

if vorbis_dep.found()
  sound_readers += files('RageSoundReader_Vorbisfile.cpp')
  deps += vorbis_dep
endif

if mad_dep.found()
  sound_readers += files('RageSoundReader_MP3.cpp')
  deps += mad_dep
endif

if jpeg_dep.found()
  stepmania_sources += files(
    'RageSurface_Load_JPEG.cpp',
    'SDL_SaveJPEG.cpp',
  )
  deps += jpeg_dep
endif

if use_networking
  stepmania_sources += files('ezsockets.cpp')
endif

if online_dep.found()
  stepmania_sources += files(system == 'windows' ? 'OnlineHttp_WinHttp.cpp' : 'OnlineHttp_Curl.cpp')
  deps += online_dep
else
  stepmania_sources += files('OnlineHttp_None.cpp')
endif

if use_crash_handler
  stepmania_sources += files(
    'archutils/Unix/Backtrace.cpp',
    'archutils/Unix/BacktraceNames.cpp',
    'archutils/Unix/CrashHandler.cpp',
    'archutils/Unix/CrashHandlerChild.cpp',
  )
  deps += execinfo_dep
endif

if system == 'linux'
  stepmania_sources += files(
    'arch/Lights/LightsDriver_LinuxWeedTech.cpp',
    'arch/MemoryCard/MemoryCardDriverThreaded_Linux.cpp',
  )
  if cpu in ['x86', 'x86_64']
    stepmania_sources += files('arch/Lights/LightsDriver_LinuxParallel.cpp')
  endif
endif

stepmania_sources += sound_readers

if system == 'windows'
  windows = import('windows')
  stepmania_sources += windows.compile_resources('archutils/Win32/stepmania.rc',
    depend_files: ['archutils/Win32/stepmania.ico', 'archutils/Win32/stepmania.manifest'])
endif

stepmania = executable('stepmania',
  stepmania_sources,
  include_directories: [top_inc, src_inc],
  dependencies: deps,
  export_dynamic: use_crash_handler,
  link_args: exe_link_args,
  win_subsystem: system == 'windows' ? 'windows' : 'console',
  install: true,
  install_dir: pkglibexecdir)

if get_option('tests')
  subdir('tests')
endif
