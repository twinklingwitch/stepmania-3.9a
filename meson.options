option('alsa', type: 'feature', value: 'auto', description: 'ALSA sound drivers')
option('oss', type: 'feature', value: 'auto', description: 'OSS sound driver')
option('sndio', type: 'feature', value: 'auto', description: 'sndio sound driver')
option('ffmpeg', type: 'feature', value: 'auto', description: 'FFmpeg movie textures')
option('vorbis', type: 'feature', value: 'auto', description: 'Ogg Vorbis decoding')
option('mad', type: 'feature', value: 'auto', description: 'MP3 decoding with libmad')
option('jpeg', type: 'feature', value: 'auto', description: 'JPEG loading and saving')
option('networking', type: 'boolean', value: true, description: 'Network play and package downloads')
option('crash_handler', type: 'boolean', value: true, description: 'Fatal signal handler with backtraces')
option('tests', type: 'boolean', value: false, description: 'Build and register the unit tests')
option('dll_dirs', type: 'array', value: [], description: 'Windows: directories to copy DLLs from when installing')
option('online', type: 'feature', value: 'auto', description: 'Online scores: libcurl on Unix, WinHTTP on Windows')
